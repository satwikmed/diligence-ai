# Copy to .env.local (never commit .env.local).
#
# Demo mode on Vercel (no backend): set OPENAI_API_KEY for real Q&A on analysis pages.
OPENAI_API_KEY=sk-your-key-here
#
# Leave NEXT_PUBLIC_API_URL unset on Vercel to use built-in demo data (History, Compare, Reports).
# For local dev with FastAPI backend:
#   NEXT_PUBLIC_API_URL=http://localhost:8000
#   NEXT_PUBLIC_WS_URL=ws://localhost:8000
#
# For production with live uploads, set to your deployed backend (Render/Railway):
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
# NEXT_PUBLIC_WS_URL=wss://your-backend.onrender.com
